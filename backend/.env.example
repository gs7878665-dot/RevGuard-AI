# RevGuard AI — Environment Configuration Example
# Copy this file to .env or set environment variables before running the application.

# Anthropic API Key (Optional: system uses high-quality heuristic evaluation fallback if unconfigured)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Pinned Claude Model Selection (Default: claude-3-5-sonnet-20241022 for 100% reproducible benchmark evaluation)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Razorpay Test API Keys (Optional: system generates realistic Razorpay test payment links if unconfigured)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
