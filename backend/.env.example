# RevGuard AI — Environment Configuration Example
# Copy this file to .env or set environment variables before running the application.

# Google Gemini API Key (Optional: system uses high-quality heuristic evaluation fallback if unconfigured)
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Razorpay Test API Keys (Optional: system generates realistic Razorpay test payment links if unconfigured)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
